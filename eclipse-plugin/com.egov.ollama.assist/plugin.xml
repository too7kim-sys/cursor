<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="com.egov.ollama.assist.category"
            name="Ollama Assist"/>
      <view
            id="com.egov.ollama.assist.chatView"
            name="Ollama Assist"
            category="com.egov.ollama.assist.category"
            class="com.egov.ollama.assist.ui.ChatView"
            restorable="true"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category
            id="com.egov.ollama.assist.commands"
            name="Ollama Assist"/>
      <command
            id="com.egov.ollama.assist.explain"
            name="Ollama: 코드 설명"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.refactor"
            name="Ollama: 리팩터링 제안"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.sendToView"
            name="Ollama: 선택 코드 보내기"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.complete"
            name="Ollama: 자동완성(커서 위치)"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.test"
            name="Ollama: 테스트 생성"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.doc"
            name="Ollama: 주석 생성"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.review"
            name="Ollama: 코드 리뷰"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.inlineEdit"
            name="Ollama: 인라인 편집(선택 코드 수정)"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.ghostComplete"
            name="Ollama: 고스트 완성(미리보기)"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.fixError"
            name="Ollama: 오류 수정(현재 줄/선택)"
            categoryId="com.egov.ollama.assist.commands"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.egov.ollama.assist.explain"
            class="com.egov.ollama.assist.handlers.ExplainHandler"/>
      <handler
            commandId="com.egov.ollama.assist.refactor"
            class="com.egov.ollama.assist.handlers.RefactorHandler"/>
      <handler
            commandId="com.egov.ollama.assist.sendToView"
            class="com.egov.ollama.assist.handlers.SendToViewHandler"/>
      <handler
            commandId="com.egov.ollama.assist.complete"
            class="com.egov.ollama.assist.handlers.CompleteHandler"/>
      <handler
            commandId="com.egov.ollama.assist.test"
            class="com.egov.ollama.assist.handlers.TestHandler"/>
      <handler
            commandId="com.egov.ollama.assist.doc"
            class="com.egov.ollama.assist.handlers.DocHandler"/>
      <handler
            commandId="com.egov.ollama.assist.review"
            class="com.egov.ollama.assist.handlers.ReviewHandler"/>
      <handler
            commandId="com.egov.ollama.assist.inlineEdit"
            class="com.egov.ollama.assist.handlers.InlineEditHandler"/>
      <handler
            commandId="com.egov.ollama.assist.ghostComplete"
            class="com.egov.ollama.assist.handlers.GhostCompleteHandler"/>
      <handler
            commandId="com.egov.ollama.assist.fixError"
            class="com.egov.ollama.assist.handlers.FixErrorHandler"/>
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M3+A"
            commandId="com.egov.ollama.assist.sendToView"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key
            sequence="M1+M3+SPACE"
            commandId="com.egov.ollama.assist.ghostComplete"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key
            sequence="M1+M3+I"
            commandId="com.egov.ollama.assist.inlineEdit"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key
            sequence="M1+M3+."
            commandId="com.egov.ollama.assist.fixError"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="com.egov.ollama.assist.menu"
               label="Ollama Assist">
            <command commandId="com.egov.ollama.assist.inlineEdit" style="push"/>
            <command commandId="com.egov.ollama.assist.ghostComplete" style="push"/>
            <command commandId="com.egov.ollama.assist.complete" style="push"/>
            <command commandId="com.egov.ollama.assist.fixError" style="push"/>
            <separator name="com.egov.ollama.assist.sep1" visible="true"/>
            <command commandId="com.egov.ollama.assist.explain" style="push"/>
            <command commandId="com.egov.ollama.assist.refactor" style="push"/>
            <command commandId="com.egov.ollama.assist.test" style="push"/>
            <command commandId="com.egov.ollama.assist.doc" style="push"/>
            <command commandId="com.egov.ollama.assist.review" style="push"/>
            <command commandId="com.egov.ollama.assist.sendToView" style="push"/>
         </menu>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.egov.ollama.assist.preferences"
            name="Ollama Assist"
            class="com.egov.ollama.assist.preferences.OllamaPreferencePage"/>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.egov.ollama.assist.preferences.PreferenceInitializer"/>
   </extension>
</plugin>
