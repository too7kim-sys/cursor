<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="com.egov.ollama.assist.category"
            name="Ollama Assist"/>
      <view
            id="com.egov.ollama.assist.chatView"
            name="Ollama Assist"
            category="com.egov.ollama.assist.category"
            class="com.egov.ollama.assist.ui.ChatView"
            restorable="true"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category
            id="com.egov.ollama.assist.commands"
            name="Ollama Assist"/>
      <command
            id="com.egov.ollama.assist.explain"
            name="Ollama: 코드 설명"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.refactor"
            name="Ollama: 리팩터링 제안"
            categoryId="com.egov.ollama.assist.commands"/>
      <command
            id="com.egov.ollama.assist.sendToView"
            name="Ollama: 선택 코드 보내기"
            categoryId="com.egov.ollama.assist.commands"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.egov.ollama.assist.explain"
            class="com.egov.ollama.assist.handlers.ExplainHandler"/>
      <handler
            commandId="com.egov.ollama.assist.refactor"
            class="com.egov.ollama.assist.handlers.RefactorHandler"/>
      <handler
            commandId="com.egov.ollama.assist.sendToView"
            class="com.egov.ollama.assist.handlers.SendToViewHandler"/>
   </extension>

   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M3+A"
            commandId="com.egov.ollama.assist.sendToView"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="com.egov.ollama.assist.menu"
               label="Ollama Assist">
            <command commandId="com.egov.ollama.assist.explain" style="push"/>
            <command commandId="com.egov.ollama.assist.refactor" style="push"/>
            <command commandId="com.egov.ollama.assist.sendToView" style="push"/>
         </menu>
      </menuContribution>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.egov.ollama.assist.preferences"
            name="Ollama Assist"
            class="com.egov.ollama.assist.preferences.OllamaPreferencePage"/>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="com.egov.ollama.assist.preferences.PreferenceInitializer"/>
   </extension>
</plugin>
